# GrantBoard Discord 봇 — 시크릿 템플릿
#
# ⚠️ 이 파일은 "예시"다. 실제 값은 .dev.vars 에 넣는다 (.gitignore로 막혀 있음).
# ⚠️ 이 레포는 public이다. 실제 값이 커밋되면 즉시 노출되고,
#    디스코드는 노출된 봇 토큰을 자동으로 폐기한다.
#
# 배포용 값은 파일이 아니라 wrangler secret으로 넣는다:
#   npx wrangler secret put DISCORD_BOT_TOKEN

# --- 디스코드 (discord.com/developers/applications) ---
# General Information 탭
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# Bot 탭 → Reset Token
DISCORD_BOT_TOKEN=
# 봇을 초대할 서버(길드) ID — 개발자 모드 켜고 서버 우클릭 → ID 복사
DISCORD_GUILD_ID=
# 다이제스트를 보낼 채널 ID
DISCORD_CHANNEL_ID=

# --- 공공데이터포털 (선택) ---
# K-Startup 공고 자동수집용. data.go.kr 데이터셋 15125364 활용신청 → 디코딩 인증키
DATA_GO_KR_KEY=
# 기업마당 2차 소스 (선택)
BIZINFO_CRTFC_KEY=
