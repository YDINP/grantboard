---
import type { Tone } from '../lib/format.ts';

interface Props {
  tone?: Tone;
  /** 채운 배경. 지원 불가·만료처럼 반드시 눈에 띄어야 하는 상태에만 쓴다. */
  strong?: boolean;
}

const { tone = 'neutral', strong = false } = Astro.props;
---

<span class:list={['badge', `tone-${tone}`, { strong }]}><slot /></span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface-2);
    color: var(--text-2);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.5;
    white-space: nowrap;
    vertical-align: middle;
  }

  .tone-gray {
    color: var(--gray);
    background: var(--gray-bg);
    border-color: transparent;
  }
  .tone-green {
    color: var(--green);
    background: var(--green-bg);
    border-color: transparent;
  }
  .tone-blue {
    color: var(--blue);
    background: var(--blue-bg);
    border-color: transparent;
  }
  .tone-amber {
    color: var(--amber);
    background: var(--amber-bg);
    border-color: transparent;
  }
  .tone-orange {
    color: var(--orange);
    background: var(--orange-bg);
    border-color: transparent;
  }
  .tone-red {
    color: var(--red);
    background: var(--red-bg);
    border-color: transparent;
  }

  .strong {
    color: #101216;
  }
  .strong.tone-red {
    background: var(--red);
  }
  .strong.tone-orange {
    background: var(--orange);
  }
  .strong.tone-amber {
    background: var(--amber);
  }
  .strong.tone-green {
    background: var(--green);
  }
  .strong.tone-blue {
    background: var(--blue);
  }
  .strong.tone-gray {
    background: var(--gray);
  }
</style>
