---
import Badge from './Badge.astro';
import type { ProgramView } from '../lib/board.ts';
import { formatDday, formatShortDate, isLinkable, VERDICT_LABEL, VERDICT_TONE } from '../lib/format.ts';

interface Props {
  view: ProgramView;
}

const { view } = Astro.props;
const { program, deadline, startsIn, eligibility, applications } = view;

// 접수 전(upcoming)이면 큰 숫자는 '접수 시작까지', 그 외에는 '마감까지'.
const headline =
  deadline.state === 'upcoming' && startsIn !== null && program.applyStart
    ? {
        dday: formatDday(startsIn),
        caption: `${formatShortDate(program.applyStart)} 접수 시작`,
        sr: `접수 ${formatDday(startsIn)} 시작`,
      }
    : {
        dday: formatDday(deadline.daysLeft),
        caption: `${formatShortDate(program.applyEnd)} ${deadline.state === 'closed' ? '마감됨' : '마감'}`,
        sr: deadline.state === 'closed' ? '마감됨' : `마감 ${formatDday(deadline.daysLeft)}`,
      };
---

<li class:list={['item', `state-${deadline.state}`, { dim: eligibility.verdict === 'ineligible' }]}>
  <div class="when">
    <span class="dday" aria-hidden="true">{headline.dday}</span>
    <span class="sr-only">{headline.sr}</span>
    <span class="caption">{headline.caption}</span>
  </div>

  <div class="body">
    <div class="title-row">
      {
        isLinkable(program.sourceUrl) ? (
          <a class="title" href={program.sourceUrl} target="_blank" rel="noopener">
            {program.title}
          </a>
        ) : (
          <span class="title no-link">{program.title}</span>
        )
      }
      <Badge>{program.category}</Badge>
    </div>
    <p class="org">
      {program.organizer}{program.supportAmount && <span class="amount"> · {program.supportAmount}</span>}
    </p>

    <ul class="facts">
      <li>
        <span>마감 <strong>{program.applyEnd}</strong></span>
        {
          program.applyEndTime ? (
            <strong>{program.applyEndTime}</strong>
          ) : (
            <Badge tone="orange" strong>마감 시각 미확인</Badge>
          )
        }
        {
          applications.map(({ application, targetDaysLeft, overdueUnsubmitted }) =>
            application.targetSubmitDate ? (
              <span class:list={['internal', { overdue: overdueUnsubmitted }]}>
                · 내부 마감 <strong>{application.targetSubmitDate}</strong>
                {targetDaysLeft !== null ? ` (${formatDday(targetDaysLeft)})` : ''}
                {overdueUnsubmitted && ' — 지났는데 미제출'}
              </span>
            ) : null,
          )
        }
      </li>
      {
        program.announceDate && (
          <li class="announce">
            <Badge tone="blue">발표예정 {program.announceDate}</Badge>
          </li>
        )
      }
      {
        applications.map(({ application, announceOverdue }) => (
          <li>
            <span class="status">{application.status}</span>
            <span>· 담당 {application.owner}</span>
            {application.submittedAt && <span>· 제출 {application.submittedAt}</span>}
            {
              announceOverdue && (
                <Badge tone="amber" strong>발표 예정일 경과</Badge>
              )
            }
            {application.note && <p class="note" title={application.note}>{application.note}</p>}
          </li>
        ))
      }
    </ul>

    <div class="verdict">
      <Badge tone={VERDICT_TONE[eligibility.verdict]} strong={eligibility.verdict === 'ineligible'}>
        {VERDICT_LABEL[eligibility.verdict]}
      </Badge>
      {
        eligibility.verdict !== 'eligible' && (
          <ul class="reasons">{eligibility.reasons.map((reason) => <li>{reason}</li>)}</ul>
        )
      }
    </div>
  </div>
</li>

<style>
  .item {
    --dot: var(--text-3);
    position: relative;
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    column-gap: 0.75rem;
    padding: 0.85rem 0;
  }
  .item + .item {
    border-top: 1px solid var(--line);
  }

  /* deadlineState → 색. 상태 외의 용도로 색을 쓰지 않는다. */
  .state-urgent {
    --dot: var(--red);
  }
  .state-soon {
    --dot: var(--orange);
  }
  .state-upcoming {
    --dot: var(--blue);
  }
  .state-closed {
    --dot: var(--gray);
  }

  .when {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .dday {
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--dot);
  }
  .state-open .dday {
    color: var(--text);
  }
  .state-closed .dday {
    text-decoration: line-through;
    text-decoration-thickness: 2px;
  }
  .caption {
    margin-top: 0.3rem;
    font-size: 0.72rem;
    line-height: 1.3;
    color: var(--text-3);
  }

  .body {
    position: relative;
    min-width: 0;
    padding-left: 0.85rem;
    border-left: 2px solid var(--line);
  }
  .body::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 0.45rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--dot);
    box-shadow: 0 0 0 3px var(--bg);
  }

  /* 지원 불가는 흐리게만 — 판정이 틀릴 수 있으니 숨기지 않고, 마우스를 올리면 다시 또렷하게. */
  .dim {
    opacity: 0.5;
  }
  .dim:hover,
  .dim:focus-within {
    opacity: 1;
  }

  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.5rem;
  }
  .title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }
  .title:hover {
    text-decoration: underline;
  }
  .title::after {
    content: ' ↗';
    font-size: 0.75em;
    color: var(--text-3);
  }
  .state-closed .title {
    color: var(--text-3);
    text-decoration: line-through;
  }
  /* sourceUrl이 '#'(미확보)이면 링크 대신 일반 텍스트로 렌더링한다 — 클릭해도 빈 새 탭이 열리지 않게. */
  .title.no-link {
    cursor: default;
  }
  .title.no-link::after {
    content: none;
  }
  .title.no-link:hover {
    text-decoration: none;
  }

  .org {
    margin: 0.1rem 0 0;
    font-size: 0.8125rem;
    color: var(--text-2);
  }
  .amount {
    color: var(--text-3);
  }

  .facts {
    list-style: none;
    margin: 0.45rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.8125rem;
    color: var(--text-2);
  }
  .facts li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.2rem 0.4rem;
  }
  .facts strong {
    font-weight: 600;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .status {
    font-weight: 600;
    color: var(--text);
  }
  .overdue,
  .overdue strong {
    color: var(--red);
    font-weight: 600;
  }
  /* 발표 예정일은 별도 줄의 배지로 — 마감(strong 텍스트)과 시각적으로 혼동되지 않게. */
  .announce {
    margin-top: 0.1rem;
  }

  .note {
    flex-basis: 100%;
    margin: 0.15rem 0 0;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.78rem;
    color: var(--text-3);
  }

  .verdict {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
    margin-top: 0.55rem;
  }
  .reasons {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--text-2);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
