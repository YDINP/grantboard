---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { judgeEligibility } from '../lib/eligibility.ts';
import { documentExpiry } from '../lib/documents.ts';
import { teamProfile } from '../lib/teamProfile.ts';

// 이번 단계에서는 컬렉션이 올바르게 로드/검증되는지, 파생 판정(자격요건·서류 유효기한)이
// 실제 데이터에서 어떻게 나오는지 확인하는 단순 나열 화면이다.
// 캘린더/칸반/체크리스트 UI는 다음 단계에서 별도로 붙인다.
const programs = await getCollection('programs');
const applications = await getCollection('applications');
const documents = await getCollection('documents');

const VERDICT_LABEL = {
  eligible: '지원 가능',
  ineligible: '지원 불가',
  'needs-check': '확인 필요',
} as const;

const DOC_STATE_LABEL = {
  valid: '유효',
  expiring: '만료 임박',
  expired: '만료됨',
  unknown: '기한 미확인',
} as const;
---

<BaseLayout title="GrantBoard">
  <main>
    <h1>GrantBoard</h1>
    <p>예비창업팀 지원사업 일정 대시보드 (스캐폴딩 검증용)</p>
    <p>
      팀 프로필: 사업자등록 {teamProfile.hasBusinessRegistration ? '완료' : '미등록'} · 법인{' '}
      {teamProfile.incorporatedAt ?? '미설립'} · {teamProfile.region}
    </p>

    <section>
      <h2>programs ({programs.length}건)</h2>
      <ul>
        {
          programs.map(({ data }) => {
            const judgement = judgeEligibility(data, teamProfile);
            return (
              <li>
                [{data.category}] {data.title} — {data.organizer} · 마감 {data.applyEnd}
                {data.applyEndTime ? ` ${data.applyEndTime}` : ' (시각 미확인)'}
                <br />
                자격판정: {VERDICT_LABEL[judgement.verdict]} — {judgement.reasons.join(' / ')}
              </li>
            );
          })
        }
      </ul>
    </section>

    <section>
      <h2>applications ({applications.length}건)</h2>
      <ul>
        {
          applications.map(({ data }) => (
            <li>
              {data.programId} — {data.status} (담당: {data.owner}, 우선순위: {data.priority})
              <br />
              내부 마감: {data.targetSubmitDate ?? '미설정'}
              {data.submittedAt ? ` · 제출 ${data.submittedAt}` : ''}
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2>documents ({documents.length}건)</h2>
      <ul>
        {
          documents.map(({ data }) => {
            const expiry = documentExpiry(data);
            return (
              <li>
                {data.name} [{data.kind}] — {data.ready ? '준비완료' : '미준비'}
                {data.reusable ? ' · 재사용가능' : ''}
                <br />
                유효기한: {DOC_STATE_LABEL[expiry.state]}
                {expiry.validUntil ? ` (${expiry.validUntil}, D${expiry.daysLeft! >= 0 ? '-' : '+'}${Math.abs(expiry.daysLeft!)})` : ''}
                {data.reuseSource ? ` · 재사용: ${data.reuseSource}` : ''}
              </li>
            );
          })
        }
      </ul>
    </section>
  </main>
</BaseLayout>
