---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    max-width: 100vw;
    overflow-x: hidden;
  }

  body {
    background: #111318;
    color: #e6e8ee;
    font-family:
      -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Apple SD Gothic Neo', 'Malgun Gothic',
      sans-serif;
    line-height: 1.5;
    padding: 1rem;
  }

  a {
    color: #7dd3fc;
  }

  @media (max-width: 400px) {
    body {
      padding: 0.75rem;
    }
  }
</style>
